          { "control": "Tile background image + fit", "fn": "Upload/URL image + Cover/Contain/Stretch", "key": "style.tile_bg_image / _size", "scope": "global", "default": "none / cover", "advanced": true },
          { "control": "Tile colours", "fn": "Background, border, hover, sensor-chip & expanded-panel colours", "key": "style.tile_bg / _border / _hover_* …", "scope": "global", "default": "warm-dusk set", "advanced": true }
        ]},
        { "name": "Card", "controls": [
          { "control": "Dashboard background", "fn": "Overall card background colour", "key": "style.card_bg", "scope": "global", "default": "#1e1a17", "advanced": true },
