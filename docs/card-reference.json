          { "control": "Text primary / secondary / muted", "fn": "The three text tiers", "key": "style.text_primary / _secondary / _muted", "scope": "global", "default": "#ece5dc / #b3a596 / #7e7265", "advanced": true },
          { "control": "Status colours", "fn": "Online dot / offline dot / power reading", "key": "style.online_color / offline_color / power_color", "scope": "global", "default": "#93b384 / #d47f62 / #dba25c", "advanced": true }
