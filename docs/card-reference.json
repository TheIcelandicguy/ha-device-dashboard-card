  "editorTabs": [
    { "id": "devices", "icon": "⌂", "label": "Rooms & devices",
      "note": "Auto-lists your HA areas as collapsible sections. Toolbar sets card-wide sort/visibility; the ✎ panels drill into per-room and per-device overrides.",
      "groups": [
        { "name": "Rooms toolbar", "controls": [
          { "control": "Sort", "fn": "Device sort order for the whole card (Name / Power / Online)", "key": "sort_by", "scope": "global", "default": "'name'", "advanced": false },
          { "control": "Rooms — All", "fn": "Show all rooms (clears the include-list)", "key": "areas → undefined", "scope": "global", "default": "all shown", "advanced": false },
          { "control": "Rooms — None", "fn": "Hide all rooms (explicit empty list)", "key": "areas → []", "scope": "global", "default": "all shown", "advanced": false },
          { "control": "Show offline devices", "fn": "Show or hide offline devices", "key": "show_offline", "scope": "global", "default": "true", "advanced": false }
        ]},
        { "name": "Room row + device row", "controls": [
          { "control": "Room include", "fn": "Include / exclude this room (toggling all → undefined)", "key": "areas", "scope": "global", "default": "all on", "advanced": false },
          { "control": "Device visibility", "fn": "Show / hide an individual device", "key": "hidden_devices", "scope": "global", "default": "not hidden", "advanced": false },
          { "control": "★ Favourite", "fn": "Add / remove device from the Favourites section", "key": "favorites", "scope": "global", "default": "not fav", "advanced": false },
          { "control": "Room reset ↺", "fn": "Clear this room's style block", "key": "area_styles[name] → del", "scope": "area", "default": "—", "advanced": false },
          { "control": "Device reset ↺", "fn": "Clear this device's style block", "key": "device_styles[id] → del", "scope": "device", "default": "—", "advanced": false },
          { "control": "Edit ✎ / expand ▼", "fn": "Open a style panel or device list (editor UI state)", "key": "none", "scope": "local", "default": "collapsed", "advanced": false }
        ]},
        { "name": "Per-device style panel", "controls": [
          { "control": "Type", "fn": "Override auto-detected device profile", "key": "device_styles[id].profile", "scope": "device", "default": "Auto", "advanced": false },
          { "control": "Tile layout style", "fn": "Pick tile render style (Default clears override)", "key": "device_styles[id].tile_style", "scope": "device", "default": "'default'", "advanced": false },
          { "control": "Power-monitor variant", "fn": "Sub-variant when style = power-monitor", "key": "device_styles[id].power_monitor_variant", "scope": "device", "default": "'big-number'", "advanced": false },
          { "control": "Accent colour", "fn": "Per-device accent colour", "key": "device_styles[id].color", "scope": "device", "default": "#f4601e", "advanced": false },
          { "control": "Tile icon ON", "fn": "Animated icon shown while entity is ON", "key": "device_styles[id].tile_icon", "scope": "device", "default": "none", "advanced": true },
          { "control": "Tile icon OFF", "fn": "Animated icon shown while entity is OFF", "key": "device_styles[id].tile_icon_off", "scope": "device", "default": "falls back to ON", "advanced": true },
          { "control": "Tile icon speed", "fn": "Animation speed multiplier", "key": "device_styles[id].tile_icon_speed", "scope": "device", "default": "1", "advanced": true },
          { "control": "Show graphs", "fn": "Per-device sparkline override (Inherit / On / Off)", "key": "device_styles[id].show_graphs", "scope": "device", "default": "Inherit", "advanced": false },
          { "control": "Visible blocks", "fn": "Show / hide each tile block", "key": "device_styles[id].tile_layout", "scope": "device", "default": "inherits global", "advanced": false },
          { "control": "Sensor chips", "fn": "Whitelist of sensor chips for this device", "key": "device_styles[id].sensors", "scope": "device", "default": "inherit", "advanced": false },
          { "control": "Energy shows", "fn": "Energy window for this device only (Total / Today / Week / Month)", "key": "device_styles[id].energy_period", "scope": "device", "default": "inherit", "advanced": false },
          { "control": "Energy entity", "fn": "Entity id whose energy value stands in for this device — typically a Utility Meter helper. Replaces the device's own energy sensors on the tile, in room totals and in the header chip.", "key": "device_styles[id].energy_entity", "scope": "device", "default": "the device's own energy sensors", "advanced": true },
          { "control": "Entity animations", "fn": "Per-entity ON/OFF icon + speed", "key": "device_styles[id].entity_animations[eid]", "scope": "device", "default": "none / 1", "advanced": true },
          { "control": "Hidden entities", "fn": "Remove entities from the detail sheet list", "key": "hidden_entities", "scope": "global", "default": "not hidden", "advanced": true },
          { "control": "Clear device style", "fn": "Delete the entire device-style block", "key": "device_styles[id] → del", "scope": "device", "default": "—", "advanced": false }
        ]},
        { "name": "Per-room style panel", "controls": [
          { "control": "Columns", "fn": "Tile columns in this room", "key": "area_styles[name].columns", "scope": "area", "default": "3", "advanced": false },
          { "control": "Tile gap", "fn": "Gap between tiles", "key": "area_styles[name].tileGap", "scope": "area", "default": "10px", "advanced": false },
          { "control": "Show graphs", "fn": "Per-room sparkline override", "key": "area_styles[name].show_graphs", "scope": "area", "default": "Inherit", "advanced": false },
          { "control": "Tile background", "fn": "Tile background colour", "key": "area_styles[name].tileBgColor", "scope": "area", "default": "#1c1c1e", "advanced": false },
          { "control": "Tile border", "fn": "Tile border colour", "key": "area_styles[name].tileBorderColor", "scope": "area", "default": "rgba(255,255,255,.07)", "advanced": true },
          { "control": "Tile corner radius", "fn": "Tile corner radius", "key": "area_styles[name].tileBorderRadius", "scope": "area", "default": "12px", "advanced": true },
          { "control": "Tile opacity", "fn": "Tile opacity", "key": "area_styles[name].tileOpacity", "scope": "area", "default": "100%", "advanced": true },
          { "control": "Room block border", "fn": "Border width of the room block", "key": "area_styles[name].borderWidth", "scope": "area", "default": "1px", "advanced": true },
          { "control": "Room block radius", "fn": "Corner radius of the room block", "key": "area_styles[name].borderRadius", "scope": "area", "default": "10px", "advanced": true },
          { "control": "Header gradient start", "fn": "Room header gradient start", "key": "area_styles[name].headerBgColor", "scope": "area", "default": "#1a1a2e", "advanced": true },
          { "control": "Header gradient end", "fn": "Room header gradient end", "key": "area_styles[name].headerBgColor2", "scope": "area", "default": "#0f3460", "advanced": true },
          { "control": "Header text", "fn": "Room header text colour", "key": "area_styles[name].textColor", "scope": "area", "default": "#f4601e", "advanced": true },
          { "control": "Header font size", "fn": "Room header font size", "key": "area_styles[name].fontSize", "scope": "area", "default": "12px", "advanced": true },
          { "control": "Sensor chips", "fn": "Whitelist of sensor chips for this room", "key": "area_styles[name].sensors", "scope": "area", "default": "inherit", "advanced": false },
          { "control": "Energy shows", "fn": "Energy window for this room (Total / Today / Week / Month); the room-header Energy chip sums its devices over that window", "key": "area_styles[name].energy_period", "scope": "area", "default": "inherit", "advanced": false },
          { "control": "Button shape / variant / size", "fn": "ON/OFF button style for this room", "key": "area_styles[name].button*", "scope": "area", "default": "pill / fill / md", "advanced": true }
        ]}
      ]},

    { "id": "views", "icon": "☰", "label": "Views",
      "note": "Views are filtered tabs over the same devices. Each stores at views[i]. Filters are ANDed; empty means all. Layout overrides fall through to the global defaults.",
      "groups": [
        { "name": "Views toolbar", "controls": [
          { "control": "+ Add view", "fn": "Append a new view (view_N / View N)", "key": "views[] append", "scope": "global", "default": "—", "advanced": false },
          { "control": "Default view", "fn": "Which view loads first (view 0 → undefined)", "key": "default_view", "scope": "global", "default": "first view", "advanced": false }
        ]},
        { "name": "Per-view card", "controls": [
          { "control": "▲ / ▼ Move", "fn": "Reorder this view", "key": "views[] reorder", "scope": "view", "default": "—", "advanced": false },
          { "control": "🗑 Delete", "fn": "Remove the view (clears default_view if it pointed here)", "key": "views[] remove", "scope": "view", "default": "—", "advanced": false },
          { "control": "ID", "fn": "View id — URL / localStorage key", "key": "views[i].id", "scope": "view", "default": "view_N", "advanced": true },
          { "control": "Name (tab label)", "fn": "Tab label text", "key": "views[i].name", "scope": "view", "default": "View N", "advanced": false },
          { "control": "Icon (mdi:*)", "fn": "View tab icon", "key": "views[i].icon", "scope": "view", "default": "none", "advanced": false },
          { "control": "Show Favourites section", "fn": "Enable the Favourites section on this view", "key": "views[i].show_favourites", "scope": "view", "default": "off", "advanced": false },
          { "control": "Group by room", "fn": "Group devices by room (off → false)", "key": "views[i].show_rooms", "scope": "view", "default": "on", "advanced": false }
        ]},
        { "name": "Per-view filters", "controls": [
          { "control": "Profiles (+ All / None)", "fn": "Allow-list of device profiles", "key": "views[i].filter.profiles", "scope": "view", "default": "all", "advanced": false },
          { "control": "Entity domains (+ All / None)", "fn": "Allow-list of entity domains", "key": "views[i].filter.domains", "scope": "view", "default": "all", "advanced": true },
          { "control": "Areas (+ All / None)", "fn": "Allow-list of room names", "key": "views[i].filter.areas", "scope": "area", "default": "all", "advanced": false },
          { "control": "Include specific devices", "fn": "Whitelist individual devices", "key": "views[i].filter.devices", "scope": "device", "default": "all", "advanced": false },
          { "control": "Exclude devices", "fn": "Blacklist individual devices", "key": "views[i].filter.exclude_devices", "scope": "device", "default": "none", "advanced": false },
          { "control": "Entity-ID regex", "fn": "Regex matched against entity_ids (validated live)", "key": "views[i].filter.entity_id_pattern", "scope": "view", "default": "none", "advanced": true }
        ]},
        { "name": "Per-view layout overrides", "controls": [
          { "control": "Tile style", "fn": "Override tile render style (Default → inherit)", "key": "views[i].tile_style", "scope": "view", "default": "inherit", "advanced": true },
          { "control": "Power-monitor variant", "fn": "Sub-variant when style = power-monitor", "key": "views[i].power_monitor_variant", "scope": "view", "default": "big-number", "advanced": true },
          { "control": "Columns (+ ↺)", "fn": "Override grid columns for this view", "key": "views[i].columns", "scope": "view", "default": "inherit → 3", "advanced": true },
          { "control": "Tile size", "fn": "Override tile size (inherit clears)", "key": "views[i].tile_size", "scope": "view", "default": "inherit", "advanced": true }
        ]}
      ]},

