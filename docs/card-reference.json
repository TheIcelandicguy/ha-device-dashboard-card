{
  "$comment": "Single source of truth for the Shelly dashboard card's defaults + editor map. Generated from src/editor.ts, src/helpers.ts, src/themes.ts. Consumed by docs tools (reference page, config builder, and the drag-and-drop organizers). Keep in sync when the card's config surface changes.",
  "meta": {
    "cardType": "custom:ha-device-dashboard",
    "generatedFrom": ["src/editor.ts", "src/helpers.ts", "src/themes.ts"],
    "branch": "smart-profiles"
  },

  "scopes": {
    "global": { "label": "Global",       "desc": "card-wide default (top-level config key)" },
    "view":   { "label": "View",         "desc": "per-view override (views[i])" },
    "area":   { "label": "Room",         "desc": "per-area override (area_styles[name])" },
    "device": { "label": "Device",       "desc": "per-device override (device_styles[id])" },
    "local":  { "label": "Viewer-local", "desc": "browser / editor state, not saved to YAML" }
  },

  "cascade": [
    { "order": 1, "scope": "device", "path": "device_styles[id]" },
    { "order": 2, "scope": "area",   "path": "area_styles[name]" },
    { "order": 3, "scope": "view",   "path": "views[i]" },
    { "order": 4, "scope": "global", "path": "top-level config" },
    { "order": 5, "scope": "local",  "path": "built-in profile default" }
  ],

  "defaults": {
    "$comment": "The actual runtime default VALUES. getStubConfig() writes only {type}; a config builder should emit a key ONLY when it differs from the value here (mirrors _set deleting keys equal to default).",
    "theme": "warm_dusk",
    "title": "Shelly",
    "columns": 3,
    "tile_size": "md",
    "sort_by": "name",
    "tile_style": null,
    "power_monitor_variant": "big-number",
    "smart_tile_styles": false,
    "show_offline": true,
    "show_graphs": true,
    "graph_hours": 24,
    "energy_period": "total",
    "effects": false,
    "header_show_title": true,
    "header_show_stats": true,
    "header_show_cloud": false,
    "header_show_orbs": false,
    "header_chips": ["online", "offline", "power", "alerts"],
    "sensors": null
  },

  "firstRun": [
    { "setting": "Theme",                "value": "Warm Dusk — muted terracotta on warm charcoal", "source": "DEFAULT_THEME" },
    { "setting": "Title",                "value": "\"Shelly\"",                                     "source": "title ?? 'Shelly'" },
    { "setting": "Grouping",             "value": "Auto — one collapsible section per HA area",     "source": "_groupByArea" },
    { "setting": "Columns",              "value": "3",                                              "source": "columns ?? 3" },
    { "setting": "Tile size",            "value": "Medium (md)",                                    "source": "tile_size ?? 'md'" },
    { "setting": "Sort order",           "value": "By name (A→Z)",                                  "source": "sort_by ?? 'name'" },
    { "setting": "Tile style",           "value": "Adaptive — per-profile block layout",            "source": "rawStyle → 'default'" },
    { "setting": "Smart tile styles",    "value": "Off",                                            "source": "smart_tile_styles unset" },
    { "setting": "Header chips",         "value": "Online · Offline · Power · Alerts",              "source": "DEFAULT_HEADER_CHIPS" },
    { "setting": "Graphs (sparklines)",  "value": "On",                                             "source": "show_graphs ?? true" },
    { "setting": "Offline devices",      "value": "Shown",                                          "source": "hidden only if show_offline === false" },
    { "setting": "Header orbs / effects","value": "Off",                                            "source": "effects ?? false" },
    { "setting": "Buttons",              "value": "Pill · filled · medium",                         "source": "'pill' / 'fill' / 'md'" },
    { "setting": "Views",                "value": "Single implicit \"All devices\"",                "source": "—" }
  ],

  "profiles": [
    { "key": "relay",        "label": "Relay",   "smartStyle": "power-monitor",   "chips": ["power","energy","voltage","current","temperature","overtemp","overpower"] },
    { "key": "plug",         "label": "Plug",    "smartStyle": "power-monitor",   "chips": ["power","energy","voltage","current","overtemp","overpower"] },
    { "key": "energy",       "label": "Energy",  "smartStyle": "power-monitor",   "chips": ["power","energy","voltage","current","apparent_power","power_factor","frequency"] },
    { "key": "dimmer",       "label": "Dimmer",  "smartStyle": "light-control",   "chips": ["power","energy","temperature","overtemp"] },
    { "key": "rgb",          "label": "RGB",     "smartStyle": "light-control",   "chips": ["power","energy"] },
    { "key": "climate",      "label": "TRV",     "smartStyle": "climate-control", "chips": ["temperature","humidity","battery"] },
    { "key": "wall_display", "label": "Display", "smartStyle": "climate-control", "chips": ["temperature","humidity","illuminance"] },
    { "key": "cover",        "label": "Roller",  "smartStyle": "cover-control",   "chips": ["power","energy","temperature"] },
    { "key": "valve",        "label": "Valve",   "smartStyle": "default",         "chips": ["temperature"] },
    { "key": "sensor",       "label": "Sensor",  "smartStyle": "sensor-card",     "chips": ["temperature","humidity","illuminance","co2","gas","battery","motion","door","flood","smoke","vibration"] },
    { "key": "input",        "label": "Input",   "smartStyle": "scene-button",    "chips": ["battery"] },
    { "key": "uni",          "label": "UNI",     "smartStyle": "default",         "chips": ["temperature","battery"] },
    { "key": "generic",      "label": "",        "smartStyle": "default",         "chips": [] }
  ],

  "tileBlocks": [
    { "id": "name_row",         "label": "Name & toggle" },
    { "id": "sensors",          "label": "Sensor chips" },
    { "id": "graph",            "label": "Graph" },
    { "id": "dimmer",           "label": "Brightness / colour" },
    { "id": "cover_controls",   "label": "Cover controls" },
    { "id": "trv_control",      "label": "Temperature control" },
    { "id": "valve_controls",   "label": "Valve controls" },
    { "id": "input_channels",   "label": "Input channels" },
    { "id": "relay_channels",   "label": "Relay channels" },
    { "id": "power_bar",        "label": "Power bar" },
    { "id": "virtual_controls", "label": "Virtual controls" },
    { "id": "badges",           "label": "Type & gen badges" }
  ],

  "profileBlockOrder": {
    "relay":        ["name_row","relay_channels","sensors","graph","power_bar","virtual_controls","badges"],
    "plug":         ["name_row","sensors","graph","power_bar","virtual_controls","badges"],
    "dimmer":       ["name_row","dimmer","sensors","graph","virtual_controls","badges"],
    "rgb":          ["name_row","dimmer","sensors","graph","virtual_controls","badges"],
    "climate":      ["name_row","sensors","trv_control","virtual_controls","badges"],
    "cover":        ["name_row","cover_controls","sensors","virtual_controls","badges"],
    "valve":        ["name_row","sensors","valve_controls","virtual_controls","badges"],
    "energy":       ["name_row","sensors","graph","virtual_controls","badges"],
    "sensor":       ["name_row","sensors","graph","virtual_controls","badges"],
    "input":        ["name_row","sensors","input_channels","virtual_controls","badges"],
    "uni":          ["name_row","input_channels","sensors","virtual_controls","badges"],
    "wall_display": ["name_row","sensors","trv_control","virtual_controls","badges"],
    "generic":      ["name_row","sensors","virtual_controls","badges"]
  },

  "tileStyles": [
    { "key": "default",         "label": "Default (adaptive blocks)" },
    { "key": "power-monitor",   "label": "Power monitor" },
    { "key": "light-control",   "label": "Light control" },
    { "key": "climate-control", "label": "Climate control" },
    { "key": "cover-control",   "label": "Cover control" },
    { "key": "sensor-card",     "label": "Sensor card" },
    { "key": "scene-button",    "label": "Scene button" }
  ],
  "powerMonitorVariants": ["big-number", "gauge", "graph", "compact", "table"],

  "headerChips": [
    { "key": "online",      "label": "Online",      "agg": "count" },
    { "key": "offline",     "label": "Offline",     "agg": "count" },
    { "key": "power",       "label": "Power",       "agg": "sum" },
    { "key": "energy",      "label": "Energy",      "agg": "sum" },
    { "key": "temperature", "label": "Temperature", "agg": "avg" },
    { "key": "humidity",    "label": "Humidity",    "agg": "avg" },
    { "key": "illuminance", "label": "Light",       "agg": "avg" },
    { "key": "rssi",        "label": "Wi-Fi",       "agg": "avg" },
    { "key": "alerts",      "label": "Alerts",      "agg": "count" },
    { "key": "updates",     "label": "Updates",     "agg": "count" }
  ],

  "sensorGroups": {
    "electrical": [
      { "key": "power",          "label": "Power" },
      { "key": "voltage",        "label": "Voltage" },
      { "key": "current",        "label": "Current" },
      { "key": "energy",         "label": "Energy (kWh)" },
      { "key": "frequency",      "label": "Frequency" },
      { "key": "apparent_power", "label": "App. Power" },
      { "key": "reactive_power", "label": "React. Power" },
      { "key": "power_factor",   "label": "Power Factor" }
    ],
    "environmental": [
      { "key": "temperature", "label": "Temperature" },
      { "key": "humidity",    "label": "Humidity" },
      { "key": "illuminance", "label": "Illuminance" },
      { "key": "co2",         "label": "CO₂" },
      { "key": "gas",         "label": "Gas" }
    ],
    "deviceinfo": [
      { "key": "cloud",      "label": "Cloud status" },
      { "key": "rssi",       "label": "Wi-Fi RSSI" },
      { "key": "uptime",     "label": "Uptime" },
      { "key": "ip",         "label": "IP Address" },
      { "key": "ssid",       "label": "SSID" },
      { "key": "battery",    "label": "Battery" },
      { "key": "fw_version", "label": "Firmware" },
      { "key": "mac",        "label": "MAC Address" }
    ],
    "alerts": [
      { "key": "overtemp",  "label": "Overtemp" },
      { "key": "overpower", "label": "Overpower" },
      { "key": "motion",    "label": "Motion" },
      { "key": "door",      "label": "Door / Window" },
      { "key": "flood",     "label": "Flood" },
      { "key": "smoke",     "label": "Smoke" }
    ]
  },

