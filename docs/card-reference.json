          { "control": "Energy shows", "fn": "What every Energy chip reports: Total = lifetime meter reading; Today/Week/Month = consumption this period, from recorder statistics (bucketed in HA's timezone). Falls back to the lifetime total if statistics are unavailable.", "key": "energy_period", "scope": "global", "default": "total", "advanced": false },
          { "control": "Line thickness", "fn": "Sparkline stroke width", "key": "graph_style.line_width", "scope": "global", "default": "1.5px", "advanced": true },
          { "control": "Fill area under line", "fn": "Area fill beneath the line", "key": "graph_style.fill", "scope": "global", "default": "on", "advanced": true },
