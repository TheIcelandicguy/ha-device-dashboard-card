    { "id": "graphs", "icon": "∿", "label": "Graphs & Sensors",
      "note": "All global defaults — override per room/device elsewhere. Sensor chips write to one sensors array (empty = all shown). The ∿ button on a chip also adds it to the graph palette.",
      "groups": [
        { "name": "Graph type", "controls": [
