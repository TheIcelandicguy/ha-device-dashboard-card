{
  "compilerOptions": {
    "target":              "ES2020",
    "module":              "ES2020",
    "moduleResolution":    "bundler",
    "lib":                 ["ES2020", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "strict":              true,
    "noUnusedLocals":      false,
    "noUnusedParameters":  false,
    "skipLibCheck":        true,
    "outDir":              "./dist",
    "declaration":         false,
    "sourceMap":           true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
